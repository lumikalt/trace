module Adder {
    in a : bits[8]
    in b : bits[8]
    out sum : bits[8] = 0

    rule add {
        sum := a + b
    }
}

module Top {
    inst adder : Adder

    in x : bits[8]
    in y : bits[8]
    out result : bits[8] = 0

    rule wire {
        adder.a := x
        adder.b := y
        result := adder.sum
    }
}
