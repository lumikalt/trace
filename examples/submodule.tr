module Adder {
    in a : [8]
    in b : [8]
    out sum : [8] = 0

    rule add {
        sum := (a + b).!
    }
}

module Top {
    inst adder : Adder

    in x : [8]
    in y : [8]
    out result : [8] = 0

    rule wire {
        adder.a := x
        adder.b := y
        result := adder.sum
    }
}
