-- A testbench written IN trace, not hand-written Verilog: `Top` `inst`s
-- `Accumulator` (the same DUT `examples/accumulator.tr` uses) and drives
-- it through ordinary instance-port writes across real clock cycles, via
-- a `<sequences>` rule -- exactly the multi-cycle stimulus a testbench
-- needs, using language machinery that already exists for other reasons.
--
-- `dut.inc := 5` is a plain combinational connect, not a latch: it holds
-- ONLY on the cycle that write actually fires, so a value meant to hold
-- across several cycles (`inc = 5` for 4 cycles, then `inc = 3` for 2)
-- has to be re-asserted every one of those cycles, not written once and
-- left alone the way a hand-written `reg inc = 5;` would be. That's the
-- one real difference from writing a testbench directly in Verilog.
--
-- The RESULT check is `dut.sum = 26`, the last statement below -- an
-- ordinary bare comparison, fallible by default (see DESIGN.md's
-- "Comparisons: fallible by default"). No new syntax was needed for
-- this: a comparison that fails a rule's guard makes THIS SEGMENT's
-- `<sequences>` continuation register (`__cont_drive`) stick forever
-- instead of wrapping back to 0, which is exactly a checkpoint assert --
-- see DESIGN.md's "Testbenches written in trace" section for how
-- sim/tb_accumulator_tb.v observes that from outside.
module Accumulator {
    in inc : [8]
    out sum : [8] = 0

    rule accumulate {
        sum := (sum + inc).!
    }
}

module Top {
    inst dut : Accumulator

    rule drive <sequences> {
        dut.inc := 5
        tick
        dut.inc := 5
        tick
        dut.inc := 5
        tick
        dut.inc := 5
        tick
        dut.inc := 3
        tick
        dut.inc := 3
        tick
        dut.sum = 26
    }
}
