-- DESIGN.md's `race` example: two independent computations start
-- together; whichever finishes first wins, and the loser's own FSM is
-- permanently blocked from ever completing (see "Race lowering").
module Race {
    in trigger : [1]
    out result : [8] = 0

    Fast(x : [8]) : [8] <sequences> {
        tick
        return x + 1
    }
    Slow(x : [8]) : [8] <sequences> {
        tick
        tick
        return x + 2
    }

    rule pick <sequences> {
        trigger?
        let hf = spawn Fast(1)
        let hs = spawn Slow(1)
        tick
        race[hf, hs]
        if hf.done = 1 {
            result := hf.result
        } else {
            result := hs.result
        }
    }
}
