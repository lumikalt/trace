module Child {
    in a : [8]
    in b : [8]
    out c : [8] = 0

    rule pass {
        c := (a + b).!
    }
}

module Top {
    inst x : Child

    in va : [8]
    in vb : [8]
    out result : [8] = 0

    rule write_a {
        x.a := va
    }

    rule write_b {
        x.b := vb
    }

    rule read {
        result := x.c
    }
}
