module Child {
    in a : bits[8]
    in b : bits[8]
    out c : bits[8] = 0

    rule pass {
        c := a + b
    }
}

module Top {
    inst x : Child

    in va : bits[8]
    in vb : bits[8]
    out result : bits[8] = 0

    rule write_a {
        x.a := va
    }

    rule write_b {
        x.b := vb
    }

    rule read {
        result := x.c
    }
}
