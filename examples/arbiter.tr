-- Choice example from DESIGN.md: a spec uses nondeterministic choice
-- (`any`); the impl is checked as a refinement of it. `chooses` marks
-- spec-only code.
spec AnyGrant(reqs : bits[N]) : bits[clog2(N)] <combines, chooses> {
    i := any(0..N-1)          -- free variable: the checker picks
    reqs[i]?                  -- constrained: the pick must be a requester
    return i
}

impl RoundRobin(reqs : bits[N]) : bits[clog2(N)] <combines>
    refines AnyGrant
{
    return prio(reqs)         -- deterministic logic; checked against the spec
}
