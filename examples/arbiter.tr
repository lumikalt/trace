-- Choice example from DESIGN.md: a spec uses nondeterministic choice
-- (`any`); the impl is checked as a refinement of it. `choice` marks
-- spec-only code.
spec AnyGrant(reqs : bits[N]) : bits[clog2(N)] <converges, choice> {
    i := any(0..N-1)          -- free variable: the checker picks
    reqs[i]?                  -- constrained: the pick must be a requester
    return i
}

impl RoundRobin(reqs : bits[N]) : bits[clog2(N)] <converges>
    refines AnyGrant
{
    return trunc(reqs & (~reqs + 1), clog2(N))   -- placeholder priority pick
}
