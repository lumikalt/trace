-- A depth-3 fifo (`{3}[8]`, chosen non-power-of-2 to stress
-- head/tail wraparound) -- N data-slot registers plus `head`/`count`
-- pointers rather than depth-1's single valid bit/data register pair.
-- `rule pushpop` exercises the SAME combined Enq+Deq pass-through
-- depth-1 fifos support (see fifo_passthrough.tr), generalized: the
-- guard is `count > 0` (not `valid = 1`), and `count` itself is left
-- unchanged (the Enq's +1 and the Deq's -1 net to zero). See
-- DESIGN.md's "FIFO synthesis emission" section and
-- sim/fifo_depth_tb.v, which drives fill-to-full, a full-buffer
-- pass-through, drain-to-empty, and a second fill that wraps the
-- internal pointers past the top slot index.
module FifoDepth {
    fifo f : {3}[8]

    in want_push : [1]
    in want_pop : [1]
    in push_data : [8]
    out last_deq : [8] = 0

    rule pushpop {
        (want_push = 1)?
        (want_pop = 1)?
        let x = f.Deq[]
        f.Enq[push_data]
        last_deq := x
    }

    rule push_only {
        (want_push = 1)?
        f.Enq[push_data]
    }

    rule pop_only {
        (want_pop = 1)?
        let x = f.Deq[]
        last_deq := x
    }

    schedule {
        urgency pushpop > push_only
        urgency pushpop > pop_only
        urgency push_only > pop_only
    }
}
