-- A callee's own body may call another callee as a bare statement, and
-- that nested call may itself write state -- the write threads through
-- an arbitrarily deep chain of nested calls, not just one level. Here
-- the rule calls `Outer` (bare statement), which calls `Inner` (also a
-- bare statement), which writes `v_out` -- two levels of call between
-- the rule and the actual write. See sim/call_nested_writes_tb.v.
module Top {
    input a : bits[8]
    output v_out : bits[8] = 0

    Inner(x : bits[8]) : bits[8] <combines> {
        v_out := x
        return x
    }

    Outer(x : bits[8]) : bits[8] <combines> {
        Inner(x + 1)
        return x
    }

    rule compute {
        Outer(a)
    }
}
