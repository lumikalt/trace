-- Same design as fetch2.tr, but the spawn trigger sits behind an extra
-- guard (`go`) instead of firing unconditionally the first live cycle.
-- Proves the spawn lowering's plain-0 continuation-register reset is
-- safe even when the trigger is delayed for several cycles after reset
-- (not just the immediate-trigger shape fetch2.tr exercises) --
-- see sim/fetch2_gated_tb.v and DESIGN.md's "spawn and sync" section.
module Fetch2Gated {
    mem bank0 : bits[16][8]
    mem bank1 : bits[16][8]
    in pc : bits[16]
    in go : bits[1]
    out ir : bits[32] = 0

    ReadBank0(addr : bits[16]) : bits[16] <sequences> {
        let v = bank0[addr]
        tick
        return v
    }

    ReadBank1(addr : bits[16]) : bits[16] <sequences> {
        let v = bank1[addr]
        tick
        return v
    }

    rule fetch2 <sequences> {
        (go = 1)?
        let h1 = spawn ReadBank0(pc)
        let h2 = spawn ReadBank1(pc + 1)
        tick sync[h1, h2]
        ir := pack(h1.result, h2.result)
    }
}
