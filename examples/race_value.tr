-- DESIGN.md's value-producing `race`: `A` and `B` both take exactly one
-- tick, so they finish on the SAME cycle every time -- a genuine tie,
-- not a timing accident. `race`'s tie-break (declared-first wins, same
-- convention as `prio`) means `result` must always come from `A`, never
-- `B`, no matter how many times this rule fires.
module RaceValue {
    in trigger : [1]
    out result : [8] = 0

    A(x : [8]) : [8] <sequences> {
        tick
        return (x + 10).!
    }
    B(x : [8]) : [8] <sequences> {
        tick
        return (x + 20).!
    }

    rule pick <sequences> {
        trigger?
        let ha = spawn A(1)
        let hb = spawn B(1)
        result := tick race[ha, hb]
    }
}
