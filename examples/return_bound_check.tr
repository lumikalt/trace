module RetBoundCheck {
    reg total : [8] where total < 40 = 0

    Bump(i : [8] where i < 10) : [8] where _ < 20 {
        return (i + 5).!
    }

    BadBump(i : [8] where i < 10) : [8] where _ < 20 {
        return (i + 100).!
    }

    rule step {
        total := (Bump(3) + Bump(4)).!
    }
}
