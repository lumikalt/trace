-- Minimal scalar in/out example: proves real module ports end to end.
-- `inc` is read every cycle from outside; `sum` is a registered output
-- the testbench observes through an ordinary port, not a hierarchical
-- path — see sim/accumulator_tb.v.
module Accumulator {
    in inc : [8]
    out sum : [8] = 0

    rule accumulate {
        sum := (sum + inc).!
    }
}
