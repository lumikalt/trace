module Child {
    in a : [8]
    out b : [8] = 0

    rule pass {
        b := a
    }
}

module Top {
    inst c : Child

    in sel : [1]
    in x : [8]
    out result : [8] = 0

    rule wire {
        if logic sel = 1 {
            c.a := x
        } else {
            c.a := 0
        }
        result := c.b
    }
}
