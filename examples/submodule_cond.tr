module Child {
    in a : bits[8]
    out b : bits[8] = 0

    rule pass {
        b := a
    }
}

module Top {
    inst c : Child

    in sel : bits[1]
    in x : bits[8]
    out result : bits[8] = 0

    rule wire {
        if sel = 1 {
            c.a := x
        } else {
            c.a := 0
        }
        result := c.b
    }
}
