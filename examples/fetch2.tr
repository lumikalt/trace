module Fetch2 {
    mem bank0 : [16][8]
    mem bank1 : [16][8]
    in pc : [16]
    out ir : [32] = 0

    ReadBank0(addr : [16]) : [16] <sequences> {
        let v = bank0[addr]
        tick
        return v
    }

    ReadBank1(addr : [16]) : [16] <sequences> {
        let v = bank1[addr]
        tick
        return v
    }

    rule fetch2 <sequences> {
        let h1 = spawn ReadBank0(pc)
        let h2 = spawn ReadBank1(pc + 1)
        tick sync[h1, h2]
        ir := pack(h1.result, h2.result)
    }
}
