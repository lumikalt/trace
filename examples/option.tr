-- `?T` sugar for an optional value: `{valid: [1], data: T}` under the
-- hood, reusing every bit of struct flattening/read/write machinery.
-- Verse spells the absent case `false` (tying into its logic-
-- programming failure model) rather than a dedicated `none` keyword —
-- a bare value of `T` coerces implicitly to the present case wherever
-- it's written. Unwrapping goes through the SAME `?` guard operator a
-- fifo `Deq[]`/a failing call already uses: `opt?` fails the rule (and
-- so never commits any of its writes) if `opt` is absent, or evaluates
-- to the unwrapped `T` if present — see DESIGN.md's "Option types"
-- section. `.valid`/`.data` stay directly readable too, for a
-- non-failing presence check via `if opt.valid? { ... } else { ... }`
-- (an if/while condition must itself be a fallible shape -- a plain
-- `[1]` field read needs its own explicit `?`, distinct from `opt?`'s
-- whole-value unwrap-or-fail).
module Option {
    fifo input : [8]
    reg opt : ?[8] = false
    out result : [8] = 0
    out was_present : [1] = 0
    out relayed : ?[8] = false

    -- `optional <expr>` is an explicit one-layer "present" constructor --
    -- at a plain `?[1]` it's stylistic (`optional 1'd0` reads more
    -- clearly than the bare `1'd0` a plain write already accepts:
    -- `flag_present`/`flag_value` below read 1/0, not 0/0 absent).
    reg flag : ?[1] = optional 1'd0
    out flag_present : [1] = 0
    out flag_value : [1] = 0

    -- At `??[8]` it's load-bearing, not stylistic: bare coercion
    -- (`false`, a plain `[8]` value) fills BOTH layers at once, so it
    -- can only ever reach fully-absent or fully-present. `optional
    -- false` forces just the OUTER layer present while the inner one
    -- stays `false` (absent) -- `Some(None)`, otherwise inexpressible.
    -- `fill` below writes `optional d` on top of that reset value,
    -- reaching the fully-present state (`Some(Some(d))`) through the
    -- SAME write path.
    reg nested : ??[8] = optional false
    out nested_outer_valid : [1] = 0
    out nested_inner_valid : [1] = 0
    out nested_inner_data : [8] = 0

    rule fill {
        let d = input.Deq[]
        opt := d
        nested := optional d
    }

    rule pass {
        result := opt?
    }

    rule check {
        if opt.valid? {
            was_present := 1
        } else {
            was_present := 0
        }
        -- An `?T`-typed OUTPUT port flattens/write-threads the same way
        -- an `?T`-typed reg does, but through separate bookkeeping
        -- (`__out_{port}_{field}` internal registers, `struct_reg_
        -- source` keyed by the PORT name) -- exercised here directly,
        -- not just inferred from the reg case.
        if opt.valid? {
            relayed := opt.data
        } else {
            relayed := false
        }
        if flag.valid? {
            flag_present := 1
            flag_value := flag.data
        } else {
            flag_present := 0
            flag_value := 0
        }
        nested_outer_valid := nested.valid
        nested_inner_valid := nested.data.valid
        nested_inner_data := nested.data.data
    }
}
