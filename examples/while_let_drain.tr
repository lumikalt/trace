-- `while let NAME = opt? { body }` — the loop-shaped sibling of `if
-- let`: each iteration re-checks `opt`'s presence, binding `NAME` to
-- its unwrapped value for that iteration only. Renders as literal `if
-- let` text one loop-iteration segment (DESIGN.md's "`while` lowering"
-- and "`if let`: branch-scoped Option-presence binding"), reusing `if
-- let`'s own emission machinery wholesale.
--
-- `opt` is a single-slot register, not a real queue, so this module
-- re-seeds it every iteration from `cnt` (present while `cnt <> 0`,
-- absent once it hits zero) -- the loop body may only write module
-- state directly (v0 restriction, same as plain `while`), so
-- `cnt`/`acc` are regs, not locals.
--
-- `new_cnt` is bound once via `let` and read twice (the `cnt` write,
-- then the `opt` refill decision) -- a branch-local `let` read more
-- than once, exercised here through the full `<sequences>`/`while let`
-- splice-and-reparse pipeline, not just a plain `if` (see the
-- "branch-local" tests in tests/firrtl.rs for the plain-`if` case
-- directly).
module WhileLetDrain {
    in x : [8]
    out iters : [8] = 0
    reg cnt : [8] = 0
    reg opt : ?[8] = false
    reg acc : [8] = 0

    rule r <sequences, fails> {
        cnt := x
        acc := 0
        if logic x <> 0 {
            opt := x
        } else {
            opt := false
        }
        while let v = opt? {
            acc := acc + 1
            let new_cnt = cnt - 1
            cnt := new_cnt
            if logic new_cnt <> 0 {
                opt := new_cnt
            } else {
                opt := false
            }
        }
        iters := acc
    }
}
